{
  "manifestVersion": "ElixWidgetManifestV1",
  "id": "world-clock",
  "name": "World clocks",
  "version": "1.0.0",
  "kind": "native-react",
  "entrypoint": "builtin:world-clock",
  "minimumSize": { "w": 3, "h": 2 },
  "defaultLayout": { "x": 3, "y": 1, "w": 4, "h": 2 },
  "permissions": [],
  "memory": { "storageKey": "world-clock", "defaultValue": { "zones": ["Europe/London", "Asia/Tokyo"] } }
}
