{
  "manifestVersion": "ElixWidgetManifestV1",
  "id": "shortcuts",
  "name": "Quick actions",
  "version": "1.0.0",
  "kind": "native-react",
  "entrypoint": "builtin:shortcuts",
  "minimumSize": { "w": 3, "h": 2 },
  "defaultLayout": { "x": 8, "y": 3, "w": 4, "h": 2 },
  "permissions": ["os.apps.launch", "os.settings.open"],
  "memory": { "storageKey": "shortcuts", "defaultValue": {} }
}
