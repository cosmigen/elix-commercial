{
  "manifestVersion": "ElixWidgetManifestV1",
  "id": "power",
  "name": "Power",
  "version": "1.0.0",
  "kind": "native-react",
  "entrypoint": "builtin:power",
  "minimumSize": { "w": 2, "h": 2 },
  "defaultLayout": { "x": 12, "y": 7, "w": 3, "h": 2 },
  "permissions": ["system.power.read"],
  "interactions": { "rightClick": { "type": "open-panel", "target": "controls" } },
  "memory": { "storageKey": "power", "defaultValue": {} }
}
