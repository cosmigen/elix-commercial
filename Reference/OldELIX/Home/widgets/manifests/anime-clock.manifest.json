{
  "manifestVersion": "ElixWidgetManifestV1",
  "id": "anime-clock",
  "name": "Character Clock",
  "version": "1.0.0",
  "kind": "native-react",
  "entrypoint": "builtin:anime-clock",
  "minimumSize": { "w": 2, "h": 4 },
  "defaultLayout": { "x": 9, "y": 1, "w": 3, "h": 5 },
  "permissions": [],
  "memory": { "storageKey": "anime-clock", "defaultValue": { "hour12": true } }
}
